{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": [
    "server",
    "client",
    "shared",
    "vite.config.ts",
    "client/game_base/map_const.ts",
    "types/types.ts"
  ]
}
